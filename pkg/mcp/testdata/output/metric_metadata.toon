[2]:
  - help: Requests with latency <= 1s & status < 500
    metric: http_requests_total
    target:
      instance: "localhost:9090"
      job: prometheus
    type: counter
    unit: ""
  - help: "1 => the exporter is up, 0 => it is down"
    target:
      instance: "localhost:9100"
      job: node
    type: gauge
    unit: ""
